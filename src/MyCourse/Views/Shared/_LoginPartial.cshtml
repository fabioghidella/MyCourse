@inject SignInManager<ApplicationUser> signInManager
@inject UserManager<ApplicationUser> userManager

@if (signInManager.IsSignedIn(User))
{
// If needed, all user data can be retrieved via the userManager.
// Be aware this will cost an extra database query.
// ApplicationUser applicationUser = await userManager.GetUserAsync(User);
<ul class="navbar-nav">
    <li class="nav-item active">
        <a class="nav-link" asp-page="/Account/Manage/Index" asp-area="Identity">Hello, @User.FindFirst("FullName").Value!</a>
    </li>
    <li class="nav-item active">
        <form class="form-inline" method="post" asp-page="/Account/Logout" asp-area="Identity">
            <button type="submit" class="btn btn-link text-white">Sign out</button>
        </form>
    </li>
</ul>
}
else
{
<ul class="navbar-nav">
    <li class="nav-item active">
        <a class="nav-link" asp-page="/Account/Register" asp-area="Identity">Sign up</a>
    </li>
    <li class="nav-item active">
        <a class="nav-link" asp-page="/Account/Login" asp-area="Identity">Sign in</a>
    </li>
</ul>
}